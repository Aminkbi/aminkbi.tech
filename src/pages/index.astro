---
import Base from '../layouts/Base.astro';
import OrderLab from '../components/OrderLab.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('writing')).sort((a,b) => Number(a.data.issue) - Number(b.data.issue));
const featured = entries.find(entry => entry.data.featured)!;
const notes = entries.filter(entry => !entry.data.featured);
---
<Base>
  <div class="home-intro container">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title">Notes on<br />reliable systems.</h1>
      <p class="hero-description">I’m Amin. I write about distributed systems, data, and the decisions that make software dependable.</p>
      <a class="text-link" href={`/writing/${featured.id}/`}>Read the featured essay</a>
    </section>
    <section class="featured-section" aria-labelledby="featured-title">
      <a class="featured-essay" href={`/writing/${featured.id}/`}>
        <div class="featured-copy">
          <div class="featured-kicker"><span>Featured essay</span><span>Issue {featured.data.issue}</span></div>
          <h2 id="featured-title">{featured.data.title}</h2>
        </div>
        <div class="featured-summary">
          <p>{featured.data.description}</p>
          <div class="essay-meta"><span>{featured.data.readingTime} read</span><span>Read essay <span aria-hidden="true">↗</span></span></div>
        </div>
      </a>
    </section>
    <div class="hero-visual"><OrderLab compact /></div>
  </div>
  <section class="writing-section container" aria-labelledby="selected-title">
    <div class="section-heading"><h2 id="selected-title">More writing</h2><a class="text-link" href="/writing/">All articles <span aria-hidden="true">↗</span></a></div>
    <div class="notes-grid">{notes.map(entry => <a class="note-essay" href={`/writing/${entry.id}/`}><h3>{entry.data.title}</h3><p>{entry.data.description}</p><p class="reading-time">{entry.data.readingTime} read</p><span class="note-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
</Base>
