---
import Base from '../layouts/Base.astro';
import OrderLab from '../components/OrderLab.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('writing')).sort((a,b) => Number(a.data.issue) - Number(b.data.issue));
const featured = entries.find(entry => entry.data.featured)!;
const notes = entries.filter(entry => !entry.data.featured);
---
<Base>
  <section class="hero container">
    <div class="hero-copy">
      <h1>Notes on<br />reliable<br /><em>systems.</em></h1>
      <p class="hero-description">I’m Amin. I write about distributed systems, data, and the decisions that make software dependable.</p>
      <div class="hero-actions"><a class="button" href="/writing/">Writing <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-visual"><OrderLab compact /></div>
  </section>
  <section class="writing-section container" aria-labelledby="selected-title">
    <div class="section-heading"><h2 id="selected-title">Writing</h2><a class="text-link" href="/writing/">All articles <span aria-hidden="true">↗</span></a></div>
    <a class="featured-essay" href={`/writing/${featured.id}/`}>
      <div class="featured-copy"><h3>{featured.data.title}</h3><p>{featured.data.description}</p><div class="essay-meta"><span>{featured.data.readingTime} read</span><span aria-hidden="true">↗</span></div></div>
    </a>
    <div class="notes-grid">{notes.map(entry => <a class="note-essay" href={`/writing/${entry.id}/`}><h3>{entry.data.title}</h3><p>{entry.data.description}</p><p class="reading-time">{entry.data.readingTime} read</p><span class="note-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
</Base>
